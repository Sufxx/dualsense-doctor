{
  "name": "dualsense-doctor-mcp",
  "version": "1.0.0",
  "description": "Local-first MCP server to read and control a PS5 DualSense over HID (drift diagnosis, adaptive triggers, lightbar, optional gated NVS recalibration).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dualsense-doctor-mcp": "./server.js"
  },
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke-readonly.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "node-hid": "3.3.0",
    "zod": "4.6.7"
  }
}
